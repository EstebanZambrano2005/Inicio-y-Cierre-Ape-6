import java.util.Scanner;

public class Ejercicio1GastosSemanales {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        double[] gastos = new double[7];
        double sumaTotal = 0;

        // Registrar gastos de 7 días
        for (int i = 0; i < gastos.length; i++) {
            System.out.print("Ingrese el gasto del dia " + (i + 1) + ": ");
            gastos[i] = sc.nextDouble();
            sumaTotal += gastos[i];
        }

        double promedio = sumaTotal / gastos.length;
        int diasIncrementados = 0;

        // Aplicar aumento del 10% a los días que superen el promedio
        for (int i = 0; i < gastos.length; i++) {
            if (gastos[i] > promedio) {
                gastos[i] = gastos[i] * 1.10;
                diasIncrementados++;
            }
        }

        System.out.printf("%nGasto total de la semana: %.2f%n", sumaTotal);
        System.out.printf("Promedio diario inicial: %.2f%n", promedio);
        System.out.println("Cantidad de dias con aumento del 10%: " + diasIncrementados);

        // Mostrar arreglo actualizado en orden inverso
        System.out.println("\nArreglo actualizado en orden inverso:");
        for (int i = gastos.length - 1; i >= 0; i--) {
            System.out.printf("Dia %d: %.2f%n", (i + 1), gastos[i]);
        }

        sc.close();
    }
}
