## 2. Filtro y suma condicionada de producción

```java
import java.util.Scanner;

public class Ejercicio2Produccion {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] piezas = new int[10];

        // Ingresar 10 números enteros por teclado
        for (int i = 0; i < piezas.length; i++) {
            System.out.print("Ingrese las piezas fabricadas en el turno " + (i + 1) + ": ");
            piezas[i] = sc.nextInt();
        }

        int sumaIndicesPares = 0;
        int turnosImparesMayores15 = 0;
        int sumaTotal = 0;

        for (int i = 0; i < piezas.length; i++) {
            sumaTotal += piezas[i];

            // Suma de elementos en índices pares (0, 2, 4, ...)
            if (i % 2 == 0) {
                sumaIndicesPares += piezas[i];
            }

            // Contar turnos con cantidad impar y mayor a 15
            if (piezas[i] % 2 != 0 && piezas[i] > 15) {
                turnosImparesMayores15++;
            }
        }

        double promedioGeneral = (double) sumaTotal / piezas.length;

        System.out.println("\nSuma de piezas en indices pares (0, 2, 4...): " + sumaIndicesPares);
        System.out.println("Turnos con produccion impar y mayor a 15: " + turnosImparesMayores15);
        System.out.printf("Promedio general de produccion: %.2f%n", promedioGeneral);

        sc.close();
    }
}
