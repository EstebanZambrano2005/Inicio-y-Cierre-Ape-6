```java
import java.util.Scanner;

public class Ejercicio3Rendimiento {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Ingrese la cantidad de estudiantes (n): ");
        int n = sc.nextInt();

        while (n <= 0) {
            System.out.print("La cantidad debe ser mayor a 0. Ingrese nuevamente: ");
            n = sc.nextInt();
        }

        int[] notas = new int[n];
        int sumaNotas = 0;

        // Llenar el arreglo con notas válidas entre 0 y 20
        for (int i = 0; i < n; i++) {
            int nota;
            do {
                System.out.print("Ingrese la nota del Estudiante " + (i + 1) + " (0 a 20): ");
                nota = sc.nextInt();
                if (nota < 0 || nota > 20) {
                    System.out.println("Nota invalida. Debe estar entre 0 y 20.");
                }
            } while (nota < 0 || nota > 20);

            notas[i] = nota;
            sumaNotas += nota;
        }

        // Evitar división entera casteando a double
        double promedio = (double) sumaNotas / n;
        int aprobados = 0;
        int reprobados = 0;

        for (int i = 0; i < n; i++) {
            if (notas[i] >= 14) {
                aprobados++;
            } else {
                reprobados++;
            }
        }

        System.out.printf("%nPromedio general del curso: %.2f%n", promedio);
        System.out.println("Estudiantes aprobados (nota >= 14): " + aprobados);
        System.out.println("Estudiantes reprobados (nota < 14): " + reprobados);

        System.out.println("\nEstudiantes con nota estrictamente por debajo del promedio:");
        boolean hayDebajoPromedio = false;
        for (int i = 0; i < n; i++) {
            if (notas[i] < promedio) {
                System.out.println("- Estudiante " + (i + 1) + " (Nota: " + notas[i] + ")");
                hayDebajoPromedio = true;
            }
        }

        if (!hayDebajoPromedio) {
            System.out.println("Ningun estudiante esta por debajo del promedio.");
        }

        sc.close();
    }
}
